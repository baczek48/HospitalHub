# -*- mode: python ; coding: utf-8 -*-
import sys
sys.path.insert(0, SPECPATH)
from exe_version_info import version_info  # autor, copyright, wersja (2026-11-24)
from PyInstaller.utils.hooks import collect_submodules

# "Rejestr HL7" (2026-11-19): python-oracledb in thin mode - no hook ships for
# it, and parts of it are imported by name at run time.
_ORACLEDB = collect_submodules('oracledb')
# thin_impl (compiled) imports cryptography.x509 / hazmat itself - invisible to
# the analysis; without them: DPY-3016 "cannot import name x509" (2.0.39).
_ORACLEDB += collect_submodules('cryptography')


a = Analysis(
    ['remote_main.py'],
    pathex=[],
    binaries=[],
    datas=[('ui', 'ui')],
    hiddenimports=_ORACLEDB + ['app_version', '_build_info', 'ui.about_dialog', 'win32gui', 'win32con', 'win32api', 'PyQt6.QtNetwork', 'ui.theme',
                   # MSAA (FortiClient profile, Stage 63): the oleacc wrapper is
                   # generated by comtypes.client.GetModule and never imported
                   # statically, so PyInstaller would leave it out (H1).
                   'comtypes.gen.Accessibility',
                   'comtypes.gen._1EA4DBF0_3C3B_11CF_810C_00AA00389B71_0_1_1',
                   # RDP in a terminal tab (ui.rdp_embedded, 2026-11-13):
                   # the wrapper of mstscax.dll, generated the same way.
                   'comtypes.gen.MSTSCLib',
                   'comtypes.gen._8C11EFA1_92C3_11D1_BC1E_00C04FA31489_0_1_0'],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='HospitalHubRemote',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=['icon.ico'],
    version=version_info('HospitalHub Portable', 'HospitalHubRemote', 'HospitalHubRemote.exe'),
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name='HospitalHubRemote',
)
